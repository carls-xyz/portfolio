# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=re_ta_cle

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=ton.adresse@exemple.com

# Optionnel : expéditeur affiché. Par défaut le domaine de test Resend,
# qui ne délivre qu'à l'adresse du titulaire du compte Resend.
# Pour écrire à n'importe qui, vérifier un domaine sur Resend.
# CONTACT_FROM=Portfolio <contact@tondomaine.fr>

# Optionnel : ce que j'écoute, affiché sur l'accueil (bestiole avec un casque).
# Clé gratuite sur https://www.last.fm/api/account/create ; Apple Music doit
# être « scrobblé » vers Last.fm par une app. Sans ces deux variables, rien ne s'affiche.
# LASTFM_API_KEY=
# LASTFM_USER=          (LASTFM_USERNAME marche aussi)
# Limiteur partagé obligatoire en production (base Redis Upstash).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
